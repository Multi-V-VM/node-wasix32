# Dockerfile for building Node.js for WASIX
FROM ubuntu:latest

# Prevent apt from asking for user input
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build python3 python3-pip git wget ca-certificates jq curl clang lld llvm pkg-config file

# Install Node.js v24
RUN curl -sL https://deb.nodesource.com/setup_24.x | bash - && apt-get install -y nodejs

# Set up a working directory
WORKDIR /work
ENV WASIX_SYSROOT_PATH=/work/wasix-sysroot
ENV CC="clang --target=wasm32-wasi"
ENV CXX="clang++ --target=wasm32-wasi"
ENV AR=llvm-ar
ENV LD=ld.lld

# Provide wasixcc toolchain wrappers inside the image
RUN bash -lc 'cat > /usr/local/bin/wasixcc <<"EOF"\n#!/usr/bin/env bash\nexec clang --target=wasm32-wasi "$@"\nEOF' && \
    chmod +x /usr/local/bin/wasixcc && \
    bash -lc 'cat > /usr/local/bin/wasixcc++ <<"EOF"\n#!/usr/bin/env bash\nexec clang++ --target=wasm32-wasi "$@"\nEOF' && \
    chmod +x /usr/local/bin/wasixcc++ && \
    bash -lc 'cat > /usr/local/bin/wasixld <<"EOF"\n#!/usr/bin/env bash\nexec ld.lld "$@"\nEOF' && \
    chmod +x /usr/local/bin/wasixld && \
    bash -lc 'cat > /usr/local/bin/wasixar <<"EOF"\n#!/usr/bin/env bash\nexec llvm-ar "$@"\nEOF' && \
    chmod +x /usr/local/bin/wasixar
